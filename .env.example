# === Discord ===
# Токен бота (Developer Portal → Bot → Reset Token). НИКОМУ не показывайте.
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information)
DISCORD_CLIENT_ID=
# Необязательно: ID тестового сервера для мгновенной регистрации команд (npm run deploy -- --guild)
DEV_GUILD_ID=

# === Шифрование AI-токенов (AES-256-GCM) ===
# 64 hex-символа (32 байта). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВНИМАНИЕ: если поменять ключ, ранее сохранённые AI-токены перестанут расшифровываться.
ENCRYPTION_KEY=

# === База данных (SQLite через встроенный node:sqlite) ===
DATABASE_PATH=./data/bot.db

# === Сбор данных с форума ===
FORUM_BASE_URL=https://forum.grand-rp.su
# --- Белый список форума (заполняйте только то, что согласовала администрация форума) ---
# User-Agent, который форум добавил в белый список
SCRAPER_USER_AGENT=NovaRP-AI-Bot/1.0 (Discord bot; polite scraper)
# Дополнительный заголовок/ключ от администрации форума, формат «Имя: значение», например: X-Bot-Key: abc123
FORUM_EXTRA_HEADER=
# Прокси с IP, который форум добавил в белый список (например, http://user:pass@host:port). Только для запросов к форуму.
FORUM_PROXY_URL=
# Пауза между запросами к форуму, мс
SCRAPE_DELAY_MS=2500
# Сколько тем максимум брать из одного источника-раздела (вместе с подразделами)
SCRAPE_MAX_THREADS_PER_SOURCE=60
# Сколько страниц списка тем в разделе просматривать
SCRAPE_FORUM_PAGES=2
# Сколько страниц одной темы скачивать
SCRAPE_MAX_PAGES_PER_THREAD=3
# Не скачивать тему повторно, если она скачана менее N минут назад и в ней нет новых сообщений
SCRAPE_CACHE_MINUTES=30
# Интервал автообновления базы знаний по умолчанию (часы; меняется в меню)
DEFAULT_REFRESH_HOURS=12
# Глобальная база для ЛС (стандартные источники NOVA RP), true/false
SEED_GLOBAL_SOURCES=true

# === Уведомления о жалобах на игровые ID (/мой-id) ===
# Разделы жалоб через запятую (проверяется первая страница)
COMPLAINT_WATCH_URLS=https://forum.grand-rp.su/forums/1010/
# Как часто проверять, минут (не меньше 3)
COMPLAINT_CHECK_MINUTES=10
# Сколько страниц раздела просмотреть при первом проходе (чтобы найти уже существующие жалобы)
COMPLAINT_SCAN_PAGES=3

# === Лимиты ===
GUILD_HOURLY_LIMIT=300
DEFAULT_USER_HOURLY_LIMIT=10
DM_HOURLY_LIMIT=20
COOLDOWN_SECONDS=5

# === Необязательный AI-токен по умолчанию (если на сервере/у пользователя токен не задан) ===
# provider: openai | gemini | anthropic | groq | mistral | deepseek | xai | openrouter
DEFAULT_AI_PROVIDER=
DEFAULT_AI_TOKEN=
DEFAULT_AI_MODEL=

# debug | info | warn | error
LOG_LEVEL=info
